{
  "name": "codex-kanban",
  "version": "0.1.0",
  "description": "A local Kanban board for native Codex chats.",
  "private": true,
  "homepage": "https://github.com/luke-toledo/codex-kanban#readme",
  "bugs": {
    "url": "https://github.com/luke-toledo/codex-kanban/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luke-toledo/codex-kanban.git"
  },
  "type": "module",
  "license": "MIT",
  "keywords": ["codex", "kanban", "productivity"],
  "bin": {
    "codex-kanban": "./server.mjs"
  },
  "files": [
    "server.mjs",
    "lib/",
    "public/",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/approval-policy.test.mjs test/approvals.test.mjs test/board-store.test.mjs test/deep-link.test.mjs test/http-security.test.mjs test/normalize.test.mjs test/public-events.test.mjs test/session-auth.test.mjs",
    "test:live": "node --test --test-name-pattern='live App Server' test/live-smoke.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
